# ExamOpt Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Backend Selection ('sqlite' for offline local development, 'supabase' for cloud)
# Default: sqlite
DATABASE_BACKEND=sqlite

# Local SQLite Database (Always available for local deterministic development)
SQLITE_DB_PATH=backend/examopt.db

# Supabase Cloud Database Configuration (Required when DATABASE_BACKEND=supabase)
# Obtain your project URL and keys from: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-rotated-service-role-secret-key

# Direct PostgreSQL Connection URI (Optional for direct migrations/seeding)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Frontend Configuration (Vite environment variables)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
